# Root env for docker-compose (Redis).
# Copy to .env and fill in, or just run deploy/setup-vps.sh — it generates this.

# Auth password for Redis (clients must AUTH with this).
REDIS_PASSWORD=

# Interface + host port Redis listens on. Keep REDIS_BIND=127.0.0.1 —
# the public redis.ccl.singularitydev.xyz:6379 endpoint is an nginx
# stream proxy that forwards to this port.
REDIS_BIND=127.0.0.1
REDIS_HOST_PORT=6380
