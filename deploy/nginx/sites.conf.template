#######################  redis.${DOMAIN}  ->  landing page (TCP is on :6379)  #######################
# The actual Redis protocol endpoint is redis.${DOMAIN}:6379, proxied by the
# stream block in stream.conf. This HTTP(S) block just explains that.
server {
    listen 80;
    listen [::]:80;
    server_name ${REDIS_HOST};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://${REDIS_HOST}$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${REDIS_HOST};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    location / {
        default_type text/plain;
        return 200 "Dreamer Redis endpoint\n\nUse the Redis protocol on port 6379:\n  redis-cli -h ${REDIS_HOST} -p 6379\nThen AUTH with the REDIS_PASSWORD from the server's .env file.\n";
    }
}
